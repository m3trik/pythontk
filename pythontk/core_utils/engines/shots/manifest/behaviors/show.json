{
  "description": "Show objects at shot start, fading in -- the scene's effect recipe (Render Effects) sets the length.",
  "kind": [
    "scene"
  ],
  "family": "visibility",
  "variant": "show",
  "effect": "fade_in",
  "place": "start",
  "verify": {
    "mode": "values_in_range"
  },
  "detect": [
    "\\bfades?\\s+in\\b",
    "^\\s*(?P<object>.+?)\\s+fades?\\s+in\\b"
  ]
}
