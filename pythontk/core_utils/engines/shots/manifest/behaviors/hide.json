{
  "description": "Hide objects at shot end, fading out -- the scene's effect recipe (Render Effects) sets the length.",
  "kind": [
    "scene"
  ],
  "family": "visibility",
  "variant": "hide",
  "effect": "fade_out",
  "place": "end",
  "verify": {
    "mode": "values_in_range"
  },
  "detect": [
    "\\bfades?\\s+(?:out|away)\\b",
    "^\\s*(?P<object>.+?)\\s+fades?\\s+(?:out|away)\\b"
  ]
}
